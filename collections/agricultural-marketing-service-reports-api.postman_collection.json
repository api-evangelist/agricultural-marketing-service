        {
          "id": "99d9f167-b61f-4ce0-9e1f-fbe461b99838",
          "name": "USDA AMS Get Report",
          "request": {
            "name": "USDA AMS Get Report",
            "description": {
              "content": "Returns market news data for a specific report identified by its unique slug_id. Returns the full report data including commodity prices, volumes, and trade information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports",
                ":slug_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "Start date for filtering data within the report (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "End date for filtering data (YYYY-MM-DD). Maximum 180 days from startDate."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum records to return."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of records to skip."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "slug_id",
                  "description": "(Required) Unique identifier (Slug_ID) for the market news report."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
